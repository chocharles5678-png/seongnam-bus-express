const {
  Document, Packer, Paragraph, TextRun, HeadingLevel, AlignmentType,
  Table, TableRow, TableCell, WidthType, ShadingType, BorderStyle, LevelFormat, convertInchesToTwip,
} = require('docx');
const fs = require('fs');

const W = 9360;
const GREY = 'F2F2F2';

const p = (text, o = {}) => new Paragraph({
  spacing: { after: o.after ?? 120, line: 300 },
  alignment: o.align,
  children: [new TextRun({ text, bold: o.bold, size: o.size ?? 20, color: o.color })],
});

const h = (text, level) => new Paragraph({
  heading: level,
  spacing: { before: level === HeadingLevel.HEADING_1 ? 360 : 240, after: 140 },
  children: [new TextRun({ text, bold: true, size: level === HeadingLevel.HEADING_1 ? 28 : 24, color: '1F3864' })],
});

const bullet = (text) => new Paragraph({
  numbering: { reference: 'dot', level: 0 },
  spacing: { after: 80, line: 300 },
  children: [new TextRun({ text, size: 20 })],
});

const quote = (text) => new Paragraph({
  spacing: { before: 160, after: 200, line: 320 },
  indent: { left: 360 },
  border: { left: { style: BorderStyle.SINGLE, size: 18, space: 12, color: '1F3864' } },
  children: [new TextRun({ text, size: 20, bold: true, color: '1F3864' })],
});

function table(widths, header, rows, aligns = []) {
  const cell = (text, i, isHead) => new TableCell({
    width: { size: widths[i], type: WidthType.DXA },
    shading: isHead ? { type: ShadingType.CLEAR, fill: GREY, color: 'auto' } : undefined,
    margins: { top: 60, bottom: 60, left: 100, right: 100 },
    children: [new Paragraph({
      spacing: { after: 0, line: 260 },
      alignment: aligns[i] === 'r' ? AlignmentType.RIGHT : aligns[i] === 'c' ? AlignmentType.CENTER : AlignmentType.LEFT,
      children: [new TextRun({ text: String(text), bold: isHead, size: 18 })],
    })],
  });
  return new Table({
    columnWidths: widths,
    width: { size: widths.reduce((a, b) => a + b, 0), type: WidthType.DXA },
    rows: [
      new TableRow({ tableHeader: true, children: header.map((t, i) => cell(t, i, true)) }),
      ...rows.map((r) => new TableRow({ children: r.map((t, i) => cell(t, i, false)) })),
    ],
  });
}

const doc = new Document({
  styles: { default: { document: { run: { font: '맑은 고딕', size: 20 } } } },
  numbering: {
    config: [{
      reference: 'dot',
      levels: [{ level: 0, format: LevelFormat.BULLET, text: '•', alignment: AlignmentType.LEFT,
        style: { paragraph: { indent: { left: 360, hanging: 200 } } } }],
    }],
  },
  sections: [{
    properties: { page: { margin: { top: convertInchesToTwip(1), bottom: convertInchesToTwip(1), left: convertInchesToTwip(1), right: convertInchesToTwip(1) } } },
    children: [
      new Paragraph({
        spacing: { after: 60 },
        alignment: AlignmentType.CENTER,
        children: [new TextRun({ text: '성남시 이동격차 분석 중간 정리', bold: true, size: 36, color: '1F3864' })],
      }),
      new Paragraph({
        spacing: { after: 320 },
        alignment: AlignmentType.CENTER,
        border: { bottom: { style: BorderStyle.SINGLE, size: 8, space: 8, color: '1F3864' } },
        children: [new TextRun({ text: 'AI와 함께하는 교통문제 해결을 위한 데이터 분석 공모전  |  2026-09-22 기준', size: 18, color: '595959' })],
      }),

      h('요약', HeadingLevel.HEADING_1),
      p('성남시 원도심(수정구·중원구)은 정류장 수, 버스 운행 횟수, 정류장까지의 거리 등 기존 지표에서 모두 "양호"로 나온다. 마을버스도 이미 다니고 있다. 그러나 지형 고도와 실제 도로망을 넣으면 결과가 뒤집힌다.'),
      quote('정류장이 600m 안에 있는데도, 도로를 따라 아무리 돌아가도 법정 경사 기준(8.33%) 이하로는 정류장에 닿을 수 없는 노인이 19,268명이다. 성남시 노인의 10.5%다.'),
      p('이는 분당구(4.4%)의 약 4배이며, 기존 접근성 지표가 이를 전혀 잡아내지 못하는 이유는 접근성을 평면 거리로만 측정하기 때문이다. 이들에게 정류장이 먼 것도 아니다. 경사를 무시하고 도로를 따라 재면 가장 가까운 정류장까지 중앙값 173m이며, 68%는 200m 안에 정류장이 있다.'),
      p('원인은 노선망이 높이 방향으로 한 층에 몰려 있다는 데 있다. 금광2동의 경우 대상 주거지 반경 500m 안에 정류장이 17개 있고 두 곳은 하루 800대가 넘게 서지만, 17개 중 15개가 고도 73m 이하이고 주민은 85m에 산다. 평면에서 촘촘한 노선망이 단면에서는 골짜기 바닥에만 존재한다.'),
      p('따라서 제안은 "버스를 더 넣는 것"이 아니라 세 갈래다. 버스가 이미 200m 안까지 오는 2,352명에게는 마지막 20m 구간의 난간·쉼터·제설 대책을, 200~500m 떨어진 7,365명에게는 마을버스 노선의 수직 재배치를, 그조차 불가능한 9,551명에게는 DRT를 제안한다. 세 계층은 서로 겹치지 않는다.'),
      p('대상이 정류장에 아예 갈 수 없다는 뜻은 아니다. 1단계 대상이 집중된 금광2동과 양지동을 현장 확인한 결과 두 곳 모두 해당 구간이 계단이 아니라 인도였고, 보행이 가능한 노인은 통행할 수 있었다. 이 보고서가 말하는 것은 그 통행이 법이 통행 가능하다고 보는 기울기의 2.4배인 20% 경사를 지나야 한다는 것, 그리고 휠체어·보행보조기 사용자에게는 그것이 통과 불가라는 것이다. 현장 확인 내용은 3.4절에 그대로 실었다.'),
      p('탄소중립과의 관계는 감축량 추정이 아니라 전제조건으로 규정한다. 탄소정책은 승용차 이용의 비용을 올려 대중교통으로의 전환을 유도하지만, 그 전환은 대중교통에 도달할 수 있는 사람에게만 성립한다. 이 19,268명에게는 전환할 대안이 없으므로 같은 정책이 이동 자체를 줄이는 방향으로 작용한다.'),

      h('1. 분석 대상과 사용 데이터', HeadingLevel.HEADING_1),
      p('대상지는 경기도 성남시이며, 서울 통근이 아닌 도(道) 내부 이동만을 다룬다. 성남을 고른 이유는 세 가지다. 첫째, 같은 시 안에 분당구라는 대조군이 있어 "다른 도시라서 다르다"는 반론이 통하지 않는다. 둘째, 원도심에 지하철 8호선 다섯 개 역이 있어 "교통이 없어서 불편하다"는 흔한 진단과 구분된다. 셋째, 마을버스 인가와 노선 조정 권한이 성남시에 있어 단독 실행이 가능하다.'),
      table([1900, 2700, 2500, 2260],
        ['구분', '데이터', '출처', '기준 시점'],
        [
          ['정류장 위치', '전국 버스정류장 위치정보 (성남 1,405개)', '국토교통부', '2025-10-31'],
          ['버스 운행', '경기도 버스노선 조회 API (276개 노선)', '경기도', '2026-09'],
          ['인구', '행정동별 성·연령별 주민등록 인구', '행정안전부', '2026-08-31'],
          ['노인 분포', '국토통계 100m 격자 고령인구', '국토지리정보원', '2025-10'],
          ['지형·도로', '수치지도 1:5000 등고선·표고점·도로 (35도엽)', '국토지리정보원', '2025'],
          ['행정경계', '행정동 경계 GeoJSON', '공개 데이터셋', '2026-07-01'],
        ], ['l', 'l', 'l', 'c']),
      p('모두 무료 공공데이터이며, 상용 데이터는 사용하지 않았다.', { size: 18, color: '595959' }),

      h('2. 분석 과정과 발견', HeadingLevel.HEADING_1),

      h('2.1 기존 지표로는 원도심에 문제가 없다', HeadingLevel.HEADING_2),
      p('노선별 첫차·막차·배차간격으로 정류장마다 하루 운행 횟수를 추정한 결과, 원도심의 버스 공급은 부족하지 않았다. 오히려 중원구가 분당구보다 많다.'),
      table([1800, 1700, 2200, 1700, 1960],
        ['구', '정류장(개)', '도내 하루 운행(중앙값)', '노인 비율', '1km²당 정류장'],
        [
          ['수정구', '289', '141회', '21.8%', '6.4개'],
          ['중원구', '298', '242회', '22.8%', '11.3개'],
          ['분당구', '703', '203회', '17.3%', '10.1개'],
        ], ['l', 'r', 'r', 'r', 'r']),
      p('수정구의 밀도가 낮게 보이는 것은 신촌동·금토동 등 그린벨트가 면적에 포함되기 때문이다. 사람이 사는 동네 단위로 보면 노인 비율 25% 이상인 동의 정류장 밀도는 1km²당 19.5개로, 노인 비율이 낮은 동(15.5개)보다 오히려 높다. 인구당 정류장 수는 원도심이 낮게 나오지만 이는 원도심의 인구밀도가 높아 생기는 착시다.'),

      h('2.2 경사를 어떻게 측정했는가', HeadingLevel.HEADING_2),
      p('경사 수치는 "100m를 걸을 때 몇 m를 올라가는가"를 뜻한다. 체감으로 옮기면 다음과 같다. 층수는 아파트 한 층을 3m로 환산한 값이다.'),
      table([1500, 2100, 1700, 4060],
        ['경사', '100m당 상승', '계단 환산', '체감'],
        [
          ['1~2%', '1~2m', '반 층 이하', '평지. 분당구 주거지 대부분이 여기에 해당한다'],
          ['5%', '5m', '약 1.7층', '휠체어가 도움 없이 오를 수 있는 한계로 통용되는 수준'],
          ['8.33%', '8.3m', '약 2.8층', '건축법상 경사로에 허용되는 최대 기울기(1/12). 이 보고서의 판정 기준'],
          ['10~13%', '10~13m', '3~4층', '장바구니를 들면 중간에 멈춰 쉬게 되는 수준'],
          ['17~20%', '17~20m', '6~7층', '겨울철 결빙 시 차량도 미끄러지는 수준'],
        ], ['c', 'c', 'c', 'l']),
      p('측정은 두 단계로 했다. 먼저 수치지도 1:5000의 등고선·표고점으로 10m 격자 지형고도를 만들고, 100m 격자 고령인구 각각에서 가장 가까운 정류장까지의 직선 경사를 계산했다. 이 방식으로는 32,669명이 기준을 초과했다.'),
      p('그러나 직선은 실제 보행 경로가 아니다. 그래서 같은 수치지도의 도로 자료로 통행 가능 구역(도로 주변 15m)을 만들고, 그 위에서 "경사 8.33%를 넘지 않는 길만 사용해 정류장에 닿을 수 있는가"를 다시 계산했다. 도로를 따라 우회하면 기준 이하로 도달 가능한 경우가 상당수 있었고, 대상은 19,268명으로 줄었다. 이 보고서의 모든 수치는 도로망 기준이다.'),

      h('2.3 도로를 따라 돌아가도 닿지 못하는 노인 19,268명', HeadingLevel.HEADING_2),
      table([1800, 2000, 2200, 1500, 1860],
        ['구', '노인 인구', '기준 이하로 닿지 못함', '비율', '직선 기준(참고)'],
        [
          ['중원구', '47,692명', '8,418명', '17.7%', '28.3%'],
          ['수정구', '52,832명', '7,136명', '13.5%', '30.8%'],
          ['분당구', '83,650명', '3,714명', '4.4%', '3.5%'],
          ['성남 전체', '184,196명', '19,268명', '10.5%', '17.7%'],
        ], ['l', 'r', 'r', 'r', 'r']),
      p('직선 기준에서는 수정구가 가장 심각했으나, 도로망을 넣으면 중원구가 앞선다. 수정구에는 우회로가 있는 지역이 상대적으로 많았다는 뜻이다. 반면 분당구는 두 기준에서 모두 낮게 유지된다.'),
      p('동 단위로 보면 편차는 더 크다. 양지동 53%, 은행1동 37%, 신흥2동 32%, 금광2동 31%, 신흥1동 28%, 상대원3동 28%, 상대원1동 27%, 단대동 26% 순이다. 양지동은 노인 둘 중 하나가 여기에 해당한다. 이들 동은 모두 1970년대 광주대단지 조성 당시 산비탈에 계단식으로 지은 구역이며, 같은 수정구라도 신도시인 위례동이나 탄천변 복정동은 해당 비율이 매우 낮다. 따라서 대상은 행정구역이 아니라 "비탈에 조성된 원도심"으로 규정해야 한다.'),

      h('2.4 버스는 오히려 그쪽에 더 많이 간다', HeadingLevel.HEADING_2),
      table([3400, 2500, 3460],
        ['거주 지형', '노인 인구', '가장 가까운 정류장의 하루 운행'],
        [
          ['언덕 위 (기준 초과)', '32,486명', '260회'],
          ['평지', '151,889명', '223회'],
        ], ['l', 'r', 'r']),
      p('공급이 모자란 것이 아니라 도달하지 못하는 것이다. 기존 지표가 이를 잡지 못하는 이유는, 모든 지표가 "정류장에 도달할 수 있다"는 전제 위에서 계산되기 때문이다.'),

      h('2.5 마을버스는 이미 다니고 있다', HeadingLevel.HEADING_2),
      p('가장 흔한 대안인 "마을버스 확충"은 이미 상당 부분 실행되어 있다. 성남을 지나는 마을버스는 73개 노선이며, 우선 대상 정류장 20곳 중 19곳에 이미 마을버스가 온다. 경사에 막힌 노인의 83%는 가장 가까운 정류장에 이미 마을버스가 운행 중이다.'),
      table([3000, 6360],
        ['확인 항목', '결과'],
        [
          ['우선 대상 20곳 중 마을버스 운행', '19곳'],
          ['경사에 막힌 노인 중 최근접 정류장에 마을버스 있음', '83%'],
          ['집이 정류장보다 높은 경우', '80% (고도차 중앙값 +14m)'],
          ['성남 마을버스 배차(비첨두)', '중앙값 20분, 73개 중 47개가 20분 이상'],
          ['우선 대상에 오는 10개 노선 배차', '중앙값 18분'],
        ], ['l', 'l']),
      p('즉 문제는 마을버스의 유무가 아니라 노선의 선형과 배차다. 노선은 큰길을 따라 낮은 곳을 지나가고, 사람은 그보다 평균 14m 높은 곳에 산다. 배차는 18~20분으로, 그 간격이면 노인은 기다리지 않고 걸어 내려간다.'),

      h('2.6 우선 대상 정류장 20곳', HeadingLevel.HEADING_2),
      p('경사에 막힌 노인을 많이 담당하는 정류장 순이다. 구별로는 수정구 11곳, 중원구 9곳이다.'),
      table([300, 2750, 900, 1750, 1200, 1100, 1360],
        ['#', '정류장', '구', '해당 동', '담당 노인', '평균 경사', '하루 운행'],
        [
          ['1', '포레스티아서문·신흥2동·산성역자이2단지', '수정', '신흥2동', '1,013명', '13%', '262회'],
          ['2', '황송마을아파트', '중원', '금광1동', '571명', '11%', '114회'],
          ['3', '영장공원', '수정', '태평2·4동', '562명', '11%', '267회'],
          ['4', 'MD아파트', '수정', '수진1동', '548명', '18%', '444회'],
          ['5', '상원여중', '수정', '양지동', '532명', '13%', '176회'],
          ['6', '현성아름빌아파트', '중원', '상대원3동', '491명', '18%', '213회'],
          ['7', '신흥지구대', '수정', '신흥1동', '444명', '10%', '141회'],
          ['8', '수진동성당', '수정', '수진1·신흥1동', '442명', '12%', '112회'],
          ['9', '수진역·성호시장·성일중고입구', '중원', '신흥1동', '423명', '11%', '612회'],
          ['10', '달빛공원', '중원', '은행2동', '422명', '19%', '37회'],
          ['11', '단대동행정복지센터·성남만남지역자활센터', '중원', '금광2동', '420명', '15%', '805회'],
          ['12', '성남시의료원·신흥1동·성남아트리움', '수정', '신흥1·태평동', '413명', '12%', '640회'],
          ['13', '상대원1동복지회관', '중원', '상대원1·3동', '393명', '13%', '112회'],
          ['14', '성도신용협동조합', '수정', '태평2·3동', '380명', '12%', '267회'],
          ['15', '성남초교사거리·산성역자이1단지', '수정', '신흥2동', '376명', '19%', '260회'],
          ['16', '은행시장·남한산성시장·은행동청소년문화의집', '중원', '양지동', '372명', '12%', '862회'],
          ['17', '한국유통', '중원', '상대원1·은행2동', '366명', '10%', '152회'],
          ['18', '태평2동행정복지센터', '수정', '태평2동', '355명', '13%', '145회'],
          ['19', '이화유치원', '수정', '태평2·3동', '344명', '13%', '267회'],
          ['20', '수정구청·포레스티아서문·산성역자이2단지', '수정', '신흥2동', '339명', '14%', '260회'],
        ], ['c', 'l', 'c', 'l', 'r', 'r', 'r']),
      p('10번 달빛공원은 성격이 다르다. 평균 경사 19%로 가장 가파른데 하루 운행이 37회뿐이다. 반대로 11번 단대동행정복지센터(805회)와 16번 은행시장(862회)은 3분에 한 대꼴로 버스가 오는데도 각각 400여 명이 도달하지 못한다. 공급 확대로는 풀리지 않는다는 직접적인 증거다.'),

      h('2.7 경사가 가장 심한 정류장', HeadingLevel.HEADING_2),
      p('담당 인원이 아니라 경사만으로 순위를 매기면 목록이 달라진다. 노인 100명 이상을 담당하는 정류장 중 상위 12곳이며, 12곳 중 8곳이 중원구다.'),
      table([300, 2900, 900, 1600, 1200, 1200, 1260],
        ['#', '정류장', '구', '해당 동', '평균 경사', '최대 경사', '하루 운행'],
        [
          ['1', '우리은행앞', '중원', '상대원3동', '19.7%', '20.8%', '408회'],
          ['2', '달빛공원', '중원', '은행2동', '18.7%', '19.7%', '37회'],
          ['3', '상원초등학교·양지동청소년문화의집', '수정', '양지동', '18.5%', '19.4%', '1,023회'],
          ['4', '성남초교사거리·산성역자이1단지', '수정', '신흥2동', '18.5%', '24.1%', '260회'],
          ['5', '현성아름빌아파트', '중원', '상대원3동', '18.3%', '21.0%', '213회'],
          ['6', '하나빌라', '중원', '은행2동', '18.1%', '18.1%', '130회'],
          ['7', 'MD아파트', '수정', '수진1동', '18.0%', '28.0%', '444회'],
          ['8', '단남아파트', '중원', '금광1동', '17.5%', '19.9%', '258회'],
          ['9', '상대원시장·새마을금고', '중원', '상대원1·3동', '17.1%', '19.8%', '213회'],
          ['10', '을지대학교·생활관', '중원', '양지동', '17.1%', '20.2%', '732회'],
          ['11', '어린이공원', '중원', '은행2동', '16.9%', '16.9%', '152회'],
          ['12', '태평3동행정복지센터·태평초교', '수정', '태평3동', '16.8%', '16.8%', '145회'],
        ], ['c', 'l', 'c', 'l', 'r', 'r', 'r']),
      p('평균만 보면 실상이 가려진다. MD아파트는 평균 18.0%이지만 최대 28.0%이며, 담당 노인 548명 중 180명은 20%가 넘는 곳에 산다. 반면 달빛공원·하나빌라·어린이공원은 평균과 최대가 거의 같아, 주변이 고르게 가파르다는 뜻이다. 한편 3위 상원초등학교(1,023회)와 10위 을지대학교(732회)는 버스가 1~2분에 한 대꼴로 오는 곳이다.'),

      h('2.8 기존 연구·정책과 무엇이 다른가', HeadingLevel.HEADING_2),
      p('고령자의 대중교통 접근성은 이미 여러 기관이 다뤄 온 주제다. 이 분석이 기존 논의에 무엇을 더하는지 밝혀 둔다.'),
      table([2400, 3400, 3560],
        ['영역', '기존 연구·정책이 다룬 것', '이 분석과의 관계'],
        [
          ['차량', '시내버스 대폐차 시 저상버스 도입 의무화, 특별교통수단 공급 확대', '겹치지 않는다. 이 분석은 차량이 아니라 정류장까지의 경로를 본다'],
          ['수요응답형 교통(DRT)', '2018년 7개 지자체에서 2022년 70개 지자체로 확대. 국토교통부가 2025년 12월 도입·운영 가이드라인 배포', '겹친다. 3단계 제안은 새 제도를 요구하지 않고 이미 있는 제도를 대상 지역에 적용하는 것이다'],
          ['접근성 분석', 'GIS 네트워크 분석으로 정류장·노인복지시설 이용권의 취약지역 도출. 고령자 보행속도를 반영한 연구도 있음', '방법은 같으나 제약조건이 다르다. 기존 연구는 거리와 속도를 쓰고, 이 분석은 경사를 통과 가능 여부의 조건으로 쓴다'],
          ['보행환경 지표', '평균 경사도, 정류장 밀도, 지하철역 밀도 등을 지역 단위 지표로 사용', '여기서 갈린다. 아래에 따로 설명한다'],
          ['경로 안내 서비스', '휠체어 이용자를 위해 2cm 이상 단차, 1/8 이상 경사, 1.2m 이하 보도폭을 피하는 경로를 안내', '가장 가깝다. 다만 개인에게 우회로를 알려주는 서비스이며, 우회로가 존재하지 않는 인구를 세는 진단은 아니다'],
        ], ['l', 'l', 'l']),
      p('국토연구원의 「활력있는 초고령사회를 위한 대중교통 정책 연구」는 버스 운행 횟수, 전통시장과 대규모 점포의 접근성, 노인여가복지시설 접근성, 스마트폰을 통한 정보 접근성, 저상버스 탑승 지원의 제도화를 다룬다. 고령자의 이동을 폭넓게 조망한 연구이며, 이 보고서가 사용한 운행 횟수 지표도 같은 계열이다.'),
      quote('차이는 경사를 무엇으로 쓰는가에 있다. 기존 연구는 경사를 지역 단위의 평균값, 즉 "이 동네가 얼마나 가파른가"를 나타내는 지표로 쓴다. 이 분석은 경사를 경로의 제약조건, 즉 "기준을 넘지 않는 길만 써서 정류장에 닿을 수 있는가"의 판정 기준으로 쓴다.'),
      p('이 차이가 실제 결과를 가른다. 금광2동 대상 주거지는 평균으로 보면 문제가 드러나지 않는다. 반경 500m 안에 정류장이 17개 있고 그중 두 곳은 하루 800대가 넘게 선다. 그러나 17개 중 15개가 고도 73m 이하에 있고 주민은 85m에 산다. 평면에서 촘촘한 노선망이 단면에서는 골짜기 한 층에만 존재한다. 확인한 범위에서 정류장의 고도 분포를 주거지 고도와 대조한 분석은 찾지 못했다.'),
      p('따라서 이 분석의 기여는 새로운 해결 수단을 제시하는 데 있지 않다. 제안하는 수단은 대부분 이미 존재한다. 기여는 기존 지표가 "양호"로 판정하는 지역에서 도달 불가능한 인구를 분리해 내고, 그 규모와 위치를 제시하는 데 있다.'),
      p('다만 이 대조는 공개된 자료를 검색한 범위에서 정리한 것이며, 학술 데이터베이스를 전수 조사한 결과가 아니다. 경사를 경로 제약으로 사용한 국내 선행 연구가 존재할 가능성을 배제하지 않는다.', { size: 18, color: '595959' }),

      h('3. 정책 제안', HeadingLevel.HEADING_1),

      h('3.1 네 차례의 방향 수정', HeadingLevel.HEADING_2),
      p('분석 과정에서 당초 구상을 네 번 수정했다. 세 번은 데이터가, 한 번은 현장 확인이 근거이며, 수정 내용 자체가 이 제안의 핵심이다.'),
      table([2600, 3300, 3460],
        ['당초 구상', '수정', '근거'],
        [
          ['기존 버스를 급행화한다', '급행화는 본체가 아니다', '병목은 속도가 아니라 집에서 정류장까지의 수직 이동이다. 원도심에는 이미 하루 260~862회가 운행된다'],
          ['마을버스를 신설한다', '기존 노선을 재편한다', '마을버스는 이미 73개 노선이 운행 중이며, 우선 대상 20곳 중 19곳에 온다'],
          ['노선을 비탈 쪽으로 연장한다', '노선을 등고선 위로 올린다', '문제는 노선의 길이가 아니라 높이다. 금광2동은 반경 500m에 정류장 17개가 있으나 15개가 고도 73m 이하이고 주민은 85m에 산다'],
          ['대상은 정류장에 도달하지 못한다', '대상은 기준을 넘는 경사를 지나야 한다', '현장 확인한 두 지점(금광2동·양지동) 모두 계단이 아니라 인도였다. 보행이 가능한 노인은 통행할 수 있다. "불가"가 아니라 "부담과 위험"으로 기술한다'],
        ], ['l', 'l', 'l']),
      p('세 번째 수정은 계층별 인원을 격자 단위로 다시 판정하는 과정에서 나왔다. 종전에는 인접 격자를 묶은 덩어리마다 버스와 가장 가까운 격자를 대표로 삼아, 덩어리 전체가 실제보다 버스에 가깝게 분류됐다. 이를 바로잡자 1단계가 8,294명에서 2,352명으로, 2단계가 1,405명에서 7,365명으로 바뀌었다.', { size: 18, color: '595959' }),

      h('3.2 대상을 세 계층으로 나눈다', HeadingLevel.HEADING_2),
      p('19,268명을 하나의 해법으로 묶지 않고, 지형 조건에 따라 세 갈래로 나눈다. 계층을 가르는 기준은 "간선 정류장에서 버스가 오를 수 있는 경사(12% 이하)의 도로를 따라 몇 m 떨어져 있는가"이며, 100m 격자 단위로 판정했다. 세 계층은 서로 겹치지 않으며 합이 19,268명이다.'),
      table([1200, 1600, 3200, 3360],
        ['계층', '대상', '조치', '비용·난이도'],
        [
          ['1단계', '2,352명', '보행로 정비·경사형 승강시설 (버스가 이미 200m 안까지 옴)', '낮음. 구간이 짧아 즉시 착수 가능'],
          ['2단계', '7,365명', '마을버스 노선의 수직 재배치, 배차 단축', '운영비 증가. 노선 조정 절차 필요'],
          ['3단계', '9,551명', 'DRT(수요응답형) 등 별도 수단', '높음. 별도 사업 설계 필요'],
        ], ['c', 'r', 'l', 'l']),
      p('1단계는 버스가 이미 200m 안까지 올라오는데도 걸어서 닿지 못하는 경우, 2단계는 버스가 200~500m 떨어져 있어 노선을 올려야 하는 경우, 3단계는 12% 이하 도로로는 500m 안에 버스가 접근할 수 없거나 아예 길이 없는 경우다. 12%는 버스가 상시 운행할 수 있는 도로 경사의 통상적 한계로 설정했다.'),
      p('종전 정리에서는 이 구분을 덩어리(인접 격자 묶음) 단위로 하되 덩어리마다 버스와 가장 가까운 격자 하나를 대표로 삼았다. 그 결과 덩어리 전체가 실제보다 버스에 가깝게 분류되어 1단계가 과대, 2단계가 과소 집계됐다. 위 표는 격자 단위로 다시 판정한 값이다.', { size: 18, color: '595959' }),

      h('3.3 1단계 — 마지막 20m를 고친다', HeadingLevel.HEADING_2),
      p('2,352명은 버스가 이미 200m 안까지 올라오는데도 법정 경사 기준 이하로는 정류장에 닿지 못한다. 이들이 정류장까지 가는 길에서 8.33%를 넘는 구간이 실제로 몇 m나 되는지 계산했다. 가장 완만한 경로를 골랐을 때의 값이다.'),
      table([2400, 2000, 2000, 2960],
        ['기준 초과 구간의 길이', '인원', '비중', '성격'],
        [
          ['20m 미만', '14,753명', '76.6%', '한 구간에 집중'],
          ['20~50m', '4,017명', '20.8%', '짧은 비탈 구간'],
          ['50~100m', '498명', '2.6%', '비탈길 한 블록'],
          ['100m 이상', '0명', '0.0%', '해당 없음'],
        ], ['l', 'r', 'r', 'l']),
      p('중앙값은 10m이고, 100m를 넘는 경우는 한 명도 없다. 막고 있는 것은 긴 오르막이 아니라 짧은 구간 하나다. 이 구간의 경사는 중앙값 23.8%다.'),
      p('이 구간이 실제로 가파른지는 지형고도가 아니라 원자료인 등고선으로 따로 확인했다. 대상 인원이 많은 12개 지점에서 반경 50m의 등고선에 평면을 맞춰 경사를 다시 구한 결과는 다음과 같다.'),
      table([1800, 1500, 1900, 4160],
        ['지점', '지형고도 경사', '등고선 실측 경사', '판정'],
        [
          ['중원 금광2동', '23%', '23%', '일치. 1단계 최대 지점(521명)이며 원자료와 정확히 부합'],
          ['중원 중앙동', '14%', '27%', '일치'],
          ['분당 구미동', '29%', '34%', '일치'],
          ['수정 단대동', '20%', '18%', '일치'],
          ['수정 양지동', '21%', '15%', '일치'],
          ['중원 은행1동', '24%', '19%', '일치'],
          ['분당 판교동', '112%', '62%', '실제로 가파르나 지형고도가 부풀림'],
          ['중원 하대원동', '49%', '19%', '실제로 가파르나 지형고도가 부풀림'],
          ['분당 금곡동', '56%', '21%', '실제로 가파르나 지형고도가 부풀림'],
          ['중원 상대원1동', '28%', '8%', '지형고도 과대. 반경 30m에 등고선이 없어 보간 오차로 판단'],
          ['분당 구미1동', '34%', '8%', '지형고도 과대'],
          ['분당 금곡동', '49%', '16%', '지형고도 과대'],
        ], ['l', 'r', 'r', 'l']),
      p('12곳 중 6곳이 일치, 3곳은 실제로 가파르나 지형고도가 과장됐고, 3곳은 과대 산출이다. 과대로 판정된 3곳은 반경 30m 안에 등고선이 거의 없는 평탄지였다. 가장 중요한 지점인 금광2동이 원자료와 정확히 일치한다는 점이 이 계층의 근거다.'),
      p('다만 수치지도의 등고선 간격은 5m이므로, 5m보다 작은 지형 기복은 원자료에 존재하지 않고 보간으로 만들어진다. 따라서 이 분석이 말할 수 있는 것은 "경사 20%가 넘는 짧은 구간이 있다"까지이며, 그것이 계단인지 비탈인지, 난간이 있는지는 현장 확인으로만 구분된다.'),

      h('3.4 현장 확인 — 금광2동·양지동', HeadingLevel.HEADING_2),
      p('1단계 대상이 가장 많은 금광2동(521명)을 현장 확인했다. 확인 결과 분석의 일부는 맞고 일부는 수정이 필요했다. 수정 내용을 그대로 싣는다.'),
      p('확인 구간은 숭신여자중고교·래미안금광아파트 정류장(고도 111.0m)에서 삼성래미안아파트 단지 입구(125.6m)까지다. 도로를 따라 181m, 고도차 14.6m다. 경로의 고도 단면은 다음과 같다.'),
      table([1400, 1600, 1800, 4560],
        ['정류장에서', '고도', '구간 경사', '구간의 성격'],
        [
          ['0m', '111.0m', '—', '정류장. 앞에 다솜마을아파트'],
          ['24m', '112.6m', '+7.9%', '완만'],
          ['62m', '114.5m', '+3.8%', '완만'],
          ['77m', '115.3m', '+5.5%', '여기까지는 기준 이내'],
          ['91m', '119.6m', '+30.1%', '급경사 구간 시작'],
          ['105m', '124.8m', '+37.2%', '급경사 구간 끝. 28m에 9.5m 상승'],
          ['119m', '125.3m', '+3.0%', '이후 평지'],
          ['181m', '125.6m', '-0.1%', '삼성래미안아파트'],
        ], ['r', 'r', 'r', 'l']),
      p('전체 고도차 14.6m 가운데 9.5m가 단 28m 구간에 몰려 있다. 앞 77m는 3~8%로 완만하고 뒤 76m는 평지다. 3.3절에서 계산한 "짧은 구간 하나가 막는다"는 구조가 현장에서도 그대로 확인됐다.'),
      p('수정이 필요한 것은 두 가지였다.'),
      table([2000, 3400, 3960],
        ['항목', '분석 결과', '현장 확인 결과'],
        [
          ['해당 구간의 형태', '경사 30~37%. 계단 또는 옹벽으로 추정', '계단이 아니라 인도(人道)다. 걸어서 통행이 가능하다'],
          ['실제 경사', '지형고도 30~37%', '등고선 실측 20~21%. 지형고도가 과대 산출했다'],
        ], ['l', 'l', 'l']),
      p('따라서 이 보고서는 대상 인원을 "정류장에 도달하지 못하는 노인"이라고 기술하지 않는다. 보행이 가능한 노인은 이 구간을 지날 수 있다. 정확한 기술은 다음과 같다.'),
      quote('19,268명은 정류장에 가기 위해 경사 20%가 넘는 구간을 지나야 한다. 보행이 가능한 노인에게는 부담과 낙상 위험이며, 휠체어·보행보조기 사용자에게는 통과가 불가능하다. 20%는 법이 통행 가능하다고 보는 최대 기울기(8.33%)의 2.4배다.'),
      p('한편 현장 확인에서 예상과 달랐던 점이 하나 더 있다. 이 지역의 대상자는 산비탈의 노후 주택가 주민이 아니라 아파트 단지 주민이었다. 삼성래미안아파트, 한양수자인성남파크뷰·마크뷰아파트 세 단지가 모두 정류장보다 높은 곳에 있다.'),
      table([3000, 2000, 4360],
        ['지점', '고도', '비고'],
        [
          ['숭신여자중고교·래미안금광아파트 정류장', '111.0m', '하루 222회'],
          ['한양수자인·황송게이트볼장 정류장', '116.1m', '하루 191회'],
          ['삼성래미안아파트 (서측)', '125.6m', '정류장보다 +14.6m'],
          ['한양수자인성남마크뷰아파트', '128.6m', '정류장보다 +17.6m'],
          ['최상단 거주 격자', '141.0m', '정류장보다 +30.0m'],
        ], ['l', 'r', 'l']),
      p('단지 주민은 동 내부의 승강기로 이동하므로 지형의 영향을 받지 않는다는 반론이 가능하다. 그러나 단지 출입구 자체가 정류장보다 14~18m 높다. 단지 안에서 어떻게 내려오든 정문을 나선 뒤 정류장까지 다시 내려가야 하므로, 이 구간은 승강기로 대체되지 않는다.'),
      p('이 확인은 대상을 규정하는 방식에도 영향을 준다. 이동격차의 대상을 노후 주택가로 한정하면 이 지역은 누락된다. 지형에 따라 규정해야 하는 이유다.'),
      p('두 번째로 확인한 곳은 양지동(205명)이다. 1단계 대상은 이 두 곳에 집중되어 있다. 을지대학교·생활관 정류장(94.4m, 하루 870회)에서 주거지(107.1m)까지 164m, 고도차 12.7m다.'),
      table([1400, 1600, 1800, 4560],
        ['정류장에서', '고도', '구간 경사', '구간의 성격'],
        [
          ['0m', '94.4m', '—', '정류장. 을지고시텔·성창빌딩 앞'],
          ['40~100m', '96.7→100.3m', '+7.3% 지속', '을지대학교 앞. 기준 이내이나 계속 오르막'],
          ['124m', '100.8m', '+8.5%', '양지빌딩 부근. 여기서부터 가팔라짐'],
          ['144m', '104.3m', '+19.9%', ''],
          ['164m', '107.1m', '+20.6%', '수정아트빌'],
        ], ['r', 'r', 'r', 'l']),
      p('양지동은 금광2동과 지형의 양상이 다르다. 금광2동은 완만한 77m 뒤에 28m의 급경사가 오고 그 뒤는 평지인 집중형이다. 양지동은 164m 전체가 오르막이고 마지막 40m가 가팔라지는 지속형이다. 주거 형태도 다르다. 금광2동은 아파트 단지이고 양지동은 빌라촌(수정아트빌·우성빌라·현대아트빌라·드림하우스)이다.'),
      p('그러나 현장 확인의 결론은 같았다. 양지동의 급경사 구간도 계단이 아니라 인도였다.'),
      quote('1단계 대상이 집중된 두 지점을 모두 확인한 결과, 두 곳 다 계단이나 옹벽이 아니라 인도였다. 지형과 주거 형태가 다른데도 결과가 같다는 것은, 1단계의 조치가 통행로를 새로 만드는 것이 아니라 이미 있는 통행로를 걸을 수 있게 만드는 것이어야 함을 뜻한다.'),
      p('다만 확인한 두 곳은 모두 1단계, 즉 버스가 이미 200m 안까지 올라오는 지역이다. 버스가 접근하지 못하는 3단계 지역은 확인하지 못했으며, 그곳은 계단이나 옹벽일 가능성이 남아 있다.', { size: 18, color: '595959' }),

      p('현장 확인 결과에 따라 1단계의 조치를 다음과 같이 정한다. 확인한 두 지점이 모두 인도였으므로, 통행로를 새로 만드는 조치가 아니라 이미 있는 통행로를 걸을 수 있게 만드는 조치로 구성한다.'),
      table([2200, 2600, 4560],
        ['조치', '적용 대상', '근거'],
        [
          ['양측 연속 난간', '경사 15% 초과 보도 전 구간', '낙상 위험을 직접 낮춘다. 28m 구간이면 재료비 수준이다'],
          ['중간 쉼터(벤치)', '연속 오르막 20m 이상', '한 번 쉬면 갈 수 있는 거리로 바뀐다'],
          ['미끄럼 방지 포장', '경사 15% 초과 보도', '기존 포장 위 덧씌우기로 시공 가능'],
          ['제설·결빙 우선구역 지정', '1단계 대상 전 구간', '예산이 거의 들지 않는다. 20% 비탈이 얼면 통행이 완전히 끊긴다'],
          ['야간 조명 보강', '동일', '야간 낙상 대응'],
          ['정류장 위치 조정', '비탈 위에 기존 노선이 지나는 곳', '오르막 자체를 없앤다. 가능하면 가장 우선한다'],
        ], ['l', 'l', 'l']),
      p('경사형 승강시설은 1단계 조치에서 제외했다. 확인한 두 지점이 모두 인도였기 때문이다. 승강시설은 통행로가 계단이나 옹벽으로 끊긴 지점, 즉 3단계에 해당하는 판교동(등고선 실측 62%) 같은 곳에만 검토한다.'),
      p('제설 우선구역 지정은 비용 대비 효과가 가장 크다. 예산 증액 없이 우선순위만 조정하면 되고, 결빙 시 20% 비탈은 보행이 사실상 불가능해지기 때문이다.'),
      p('이 계층의 조치는 뒤의 3.4절 현장 확인 결과에 따라 정한다. 새 차량이 필요 없고 구간이 짧아 비용이 가장 낮으며, 뒤에 서술하듯 탄소 측면에서도 논리가 가장 단순하다.'),

      h('3.5 사례 지역 선정 — 세 군집 13곳', HeadingLevel.HEADING_2),
      p('현장 확인과 보고서 예시를 위해 사례 지역을 선정했다. 선정은 다음 기준을 모두 만족하는 100m 격자를 추린 뒤, 인접한 것끼리 묶는 방식으로 했다.'),
      table([2600, 6760],
        ['기준', '값과 근거'],
        [
          ['대상 규모', '격자당 노인 100명 이상'],
          ['버스 진입 가능 도로', '하루 200회 이상 정류장에서 도로 200m 이내. 버스가 들어올 수 없는 골목을 제외하기 위한 조건이다'],
          ['아파트 단지 제외', '반경 50m 안에 아파트 단지명이 있으면 제외. 단지 내부는 자체 통로와 승강기가 있어 공공 보행로 분석이 적용되지 않는다'],
          ['경사', '법정 기준 8.33% 초과 (분석 대상의 정의)'],
          ['도보 거리', '가장 가까운 정류장까지 도로 400m 이내'],
          ['원자료 검증', '등고선 평면 적합으로 지형고도의 경사값을 검증한 곳만 채택'],
        ], ['l', 'l']),
      p('선정 결과 세 개 군집 13곳, 노인 1,549명이 남았다. 군집을 가르는 지표는 "경로 중 기준을 초과하는 구간의 비율"이다. 이 값이 높으면 집에서 정류장까지 내내 비탈이고, 낮으면 대부분 평탄하다가 한 구간에서만 막힌다.'),
      table([2400, 1000, 1200, 1200, 1400, 2160],
        ['군집', '지점', '노인', '범위', '기준 초과 비율', '유형'],
        [
          ['중원구 상대원3동', '6곳', '715명', '333m', '71%', '내내 비탈'],
          ['수정구 신흥2동', '3곳', '313명', '427m', '74%', '내내 비탈'],
          ['중원구 은행2동·수정구 양지동', '4곳', '521명', '291m', '38%', '짧은 구간'],
        ], ['l', 'c', 'r', 'r', 'r', 'l']),
      p('상대원3동과 신흥2동은 서로 3km 떨어진 다른 지역인데 기준 초과 비율이 71%와 74%로 거의 같고, 등고선 실측 경사의 평균도 둘 다 22.2%다. 같은 유형이 서로 다른 지역에서 반복된다는 뜻이며, 단일 지점의 특수 사정이 아니다. 반면 세 번째 군집은 38%와 14.3%로 뚜렷이 구분된다.'),
      p('상대원3동에는 1·2·3단계가 모두 들어 있다. 한 동네 안에서 세 계층이 각각 어떤 조치를 필요로 하는지 보일 수 있어 대표 지역으로 삼았다.'),
      table([900, 1300, 1200, 1300, 1100, 1200, 2360],
        ['지점', '노인', '필요 경사', '등고선 실측', '계층', '도보', '가장 가까운 정류장'],
        [
          ['A', '133명', '9%', '27.1%', '2단계', '140m', '우리은행앞'],
          ['B', '127명', '9%', '16.9%', '3단계', '192m', '상대원시장'],
          ['C', '119명', '11%', '22.4%', '1단계', '92m', '상대원시장'],
          ['D', '113명', '10%', '20.7%', '2단계', '184m', '현성아름빌아파트'],
          ['E', '110명', '10%', '24.6%', '3단계', '140m', '상대원시장.새마을금고'],
          ['F', '113명', '10%', '21.5%', '2단계', '114m', '상대원시장.새마을금고'],
        ], ['c', 'r', 'r', 'r', 'c', 'r', 'l']),
      p('세 번째 군집은 행정구역 경계를 가로지른다. 291m 반경 안에 수정구 양지동 두 곳과 중원구 은행2동 두 곳이 함께 있으며 지형 조건은 같다. 이동격차의 대상을 행정구역이 아니라 지형으로 규정해야 하는 이유를 그대로 보여주는 사례다.'),
      p('현장 확인은 진행 중이다. 이 절의 13곳 가운데 확인된 곳은 양지동 한 곳(인도)이며, 상대원3동과 신흥2동은 아직 확인하지 못했다.', { size: 18, color: '595959' }),

      h('3.6 대조 사례 — 기준을 넘어도 대안이 있는 경우', HeadingLevel.HEADING_2),
      p('중원구 중앙동(217명)은 사례 지역에서 제외했다. 제외한 이유 자체가 이 분석의 한계를 보여주므로 기록해 둔다.'),
      p('이 지점은 법정 기준을 초과해 대상에 포함된다. 현장 확인에서는 광명로264번길에서 대원공원 입구로 오르는 계단이 확인됐고, 계단을 쓰지 않으면 롯데캐슬아파트 후문 쪽으로 돌아 올라가야 한다. 가장 가까운 정류장인 롯데캐슬아파트(87.4m)까지의 경로는 다음과 같다.'),
      table([2600, 1600, 1600, 3560],
        ['조건', '거리', '최대 경사', '비고'],
        [
          ['제한 없음 (계단 포함)', '176m', '60.9%', '분석이 낸 최단 경로. 계단을 도로로 취급했다'],
          ['30% 초과 제외 (계단 제외)', '251m', '29.3%', '롯데캐슬 후문 쪽 오르막'],
          ['20% 초과 제외', '497m', '19.6%', ''],
          ['8.33% 이하만', '도달 불가', '—', '법정 기준으로는 어느 경로로도 갈 수 없다'],
        ], ['l', 'r', 'r', 'l']),
      p('여기까지는 대상에 포함되는 근거가 된다. 그러나 목적지를 위쪽 정류장으로 고정하지 않으면 그림이 달라진다. 아래쪽으로 352m를 걸으면 중앙동행정복지센터(53.0m), 442m를 걸으면 단대오거리역(51.4m, 하루 1,547회)에 닿을 수 있고, 두 경로 모두 최대 경사가 9.9%이며 오르막은 총 0.6m에 불과하다.'),
      quote('즉 이 지점의 주민에게 계단은 가까운 정류장으로 가는 지름길이지 유일한 길이 아니다. 법정 기준 8.33%를 넘는다는 판정은 사실이지만, 이것이 곧 이동이 불가능하다는 뜻은 아니다.'),
      p('대상의 42%가 8.33~10% 구간에 몰려 있다는 사실이 이 형태로 나타난다. 이 보고서는 그 사실을 감추지 않으며, 사례 지역을 선정할 때 이런 지점을 대표로 쓰지 않는 방식으로 대응했다. 다만 이 지점도 방향에 따라 부담이 달라진다는 점은 지적해 둔다. 버스를 타러 갈 때는 내리막이지만, 집으로 돌아올 때는 같은 거리를 18.6m 올라야 하며 장을 본 짐은 그때 들고 온다. 대상자의 80%가 정류장보다 높은 곳에 산다는 것이 이 구조다.'),

      h('3.7 즉시 실행 가능한 개별 조치 — 정류장 신설 4곳', HeadingLevel.HEADING_2),
      p('위 계층 구분과 별개로, 기존 버스가 이미 지나가지만 정류장이 없어 주민이 더 가파른 길을 걸어 다른 정류장으로 가고 있는 지점이 있다. 기존 정류장과 150m 이상 떨어진 곳만 추렸다. 이 조치의 수혜자는 위 세 계층에 이미 포함되어 있으므로 별도로 더하지 않는다.'),
      table([1100, 1300, 1700, 1300, 1300, 2660],
        ['구', '행정동', '반경 150m 대상 노인', '현재 경사', '후보 지점 경사', '경유 노선'],
        [
          ['중원구', '금광1동', '195명', '8.4%', '6.2%', '342 (시내버스)'],
          ['중원구', '금광2동', '144명', '9.6%', '7.1%', '55 (시내버스)'],
          ['수정구', '신흥2동', '139명', '10.3%', '4.8%', '88 (마을버스)'],
          ['수정구', '단대동', '13명', '9.7%', '4.4%', '60 (시내버스)'],
        ], ['c', 'c', 'r', 'r', 'r', 'l']),
      p('금광1동 사례가 대표적이다. 현재 8.4% 경사를 걸어야 하지만, 시내버스 342번이 이미 지나는 지점에 정류장을 세우면 6.2%로 낮아진다. 표지판 설치만으로 해결되는 유형이다.'),
      p('후보 지점은 당초 7곳이었으나 4곳으로 줄였다. 후보를 뽑은 계산이 노선의 정류장을 직선으로 이어 경로를 복원한 결과여서, 도로망 기준으로 다시 확인하자 신흥3동·운중동 등 3곳은 반경 150m 안에 기준 초과 노인이 한 명도 없었다. 표의 인원도 직선 기준 "담당 노인"이 아니라 도로망 기준으로 기준을 넘긴 노인 수로 바꿨다. 네 곳 모두 현장 확인이 필요하다.'),
      p('성남 원도심은 정류장 간격이 이미 촘촘해, 정류장 신설로 풀리는 몫은 크지 않다. 이 사실 자체가 "정류장을 더 놓으면 되지 않느냐"는 반론에 대한 답이 된다.'),

      h('3.8 2단계 — 노선의 수직 재배치', HeadingLevel.HEADING_2),
      p('7,365명이 해당한다. 간선 정류장에서 버스가 오를 수 있는 경사의 도로가 이미 있으므로, 새 노선을 만들 필요 없이 기존 마을버스의 경로를 비탈 쪽으로 올리면 된다. 여기서 필요한 것은 노선을 "늘리는" 일이 아니라 "올리는" 일이다. 성남 원도심의 노선망은 평면에서 보면 촘촘하지만, 단면으로 보면 전부 골짜기 한 층에 몰려 있다.'),
      p('금광2동이 이를 단적으로 보여준다. 대상 주거지 반경 500m 안에 정류장이 17개 있고 그중 두 곳은 하루 800대가 넘게 선다. 어떤 교통 지표로 재도 "양호"다. 그러나 17개 중 15개가 고도 73m 이하에 있고, 주민은 85m에 산다. 정류장에서 주거지까지 직선으로는 166m이지만, 버스가 오를 수 있는 12% 이하 도로를 따라가면 285m다. 직선 도로는 12%보다 가팔라 버스가 올라갈 수 없다.'),
      p('대상이 100명 이상 모인 곳은 21개 덩어리이며 여기에 6,098명(83%)이 있다. 상위 지역은 다음과 같다.'),
      table([1000, 1500, 1100, 1200, 1300, 3260],
        ['구', '행정동', '노인', '연장 거리', '올라야 할 높이', '기점 정류장 (경유 마을버스)'],
        [
          ['중원구', '상대원3동', '882명', '422m', '-14.5m', '상대원3동행정복지센터 (7, 7-2)'],
          ['수정구', '양지동', '662명', '373m', '+12.5m', '은행시장·남한산성시장 (10, 88, 88-1)'],
          ['중원구', '금광2동', '625명', '285m', '+23.2m', '금광시장 (10, 10-1, 10-2)'],
          ['수정구', '신흥1동', '578명', '270m', '+10.4m', 'MD아파트 (17, 17-1, 88-1)'],
          ['수정구', '신흥1동', '392명', '289m', '+15.4m', '성남시의료원 (10-2, 3-1, 50, 78)'],
          ['수정구', '신흥2동', '376명', '397m', '+13.5m', '수정구청·산성역자이2단지 (50, 88, 88-1)'],
          ['중원구', '금광2동', '277명', '430m', '+20.6m', '숭신여자중고교 (17, 17-1, 3-4)'],
          ['중원구', '은행2동', '241명', '397m', '+10.9m', '은행동오거리 (10, 10-1, 10-2)'],
          ['중원구', '중앙동', '217명', '430m', '+19.6m', '단대오거리역 (10, 10-1, 10-2)'],
          ['중원구', '하대원동', '214명', '247m', '+18.1m', '성남자이아파트 (3-3)'],
        ], ['c', 'c', 'r', 'r', 'r', 'l']),
      p('상대원3동과 금광2동 일부는 높이차가 음수다. 주거지가 정류장보다 아래에 있는 저지대이며, 비탈 위로 올리는 것이 아니라 아래로 내리는 재편이 필요하다. 방향은 반대지만 "노선이 한 층에만 있다"는 구조는 같다.'),
      p('동시에 배차를 줄여야 한다. 현재 18~20분 간격으로는 노인이 기다리지 않고 걸어 내려간다. 노선을 올려도 배차가 그대로면 효과가 나지 않는다.'),

      h('3.9 3단계 — 버스로 닿을 수 없는 9,551명', HeadingLevel.HEADING_2),
      p('간선에서 12% 이하 도로로는 닿을 수 없는 지역이다. 상대원3동 일부처럼 등판 경사가 20%를 넘는 곳이 여기에 해당한다. 일반 버스로는 해결되지 않으므로 소형 차량 DRT 등 별도 수단이 필요하다. 이 계층은 본 보고서에서 대상 규모와 위치까지만 제시하고, 구체적 수단 설계는 후속 과제로 둔다.'),

      h('3.10 설계 기준', HeadingLevel.HEADING_2),
      p('노선을 그리는 규칙을 수치로 고정한다. 이 기준이 없으면 재편해도 기존 노선과 같아진다.'),
      table([2600, 2000, 4760],
        ['기준', '값', '근거'],
        [
          ['정류장 간 고도차', '15m 이하', '어느 집에서든 8.33% 이내로 정류장에 도달'],
          ['배차 간격', '10~15분', '현행 18~20분에서는 기다리지 않고 걸어 내려감'],
          ['환승 대기', '5분 이내', '환승 저항이 개선 효과를 상쇄하지 않도록'],
          ['차량', '소형 저상', '좁은 경사로 통행과 휠체어 승하차'],
        ], ['l', 'c', 'l']),
      p('고도차 15m 기준이 기존 정책과 결정적으로 다른 지점이다. 현재 노선 계획은 거리와 인구만을 기준으로 삼는다. 여기에 높이를 넣는 것이 이 제안의 핵심이다.'),

      h('3.11 재원', HeadingLevel.HEADING_2),
      p('예산 증액 없이 실행할 수 있다는 근거다. 은행시장(862회), 단대동행정복지센터(805회), 성남시의료원(640회)은 3분에 한 대꼴로 버스가 오지만 각각 400여 명이 도달하지 못한다. 이 구간의 운행 일부를 지선으로 옮기는 것이 같은 예산으로 더 많은 이용자를 확보하는 방법이다.'),
      p('다만 조건부다. 운행 횟수가 많다고 반드시 과잉은 아니며 실제 승하차 확인이 필요한데, 경기도는 시내버스 정류장별 승하차를 공개하지 않는다. 성남시 내부 자료 확인이 선행되어야 하며, 보고서에는 "감축"이 아니라 "이용률 검토 후 재배분"으로 기술한다.'),

      h('3.12 단계별 실행과 성과 지표', HeadingLevel.HEADING_2),
      table([1500, 4200, 3660],
        ['순서', '내용', '검증 지표'],
        [
          ['1', '정류장 신설 4곳 (현장 확인 후 즉시)', '해당 지점 이용자 수'],
          ['2', '1단계 난간·쉼터·제설 우선구역 시범 — 금광2동', '기준 초과 노인 2,352명의 감소폭'],
          ['3', '금광2동·양지동 마을버스 수직 재배치 시범', '지선 이용자 수, 환승 대기 시간'],
          ['4', '달빛공원 등 공급 부족 지점 증편', '해당 정류장 이용자 증가'],
          ['5', '2단계 대상 전역 확대 + 배차 단축', '기준 초과 노인 7,365명의 감소폭'],
          ['6', '3단계 대상 DRT 설계', '미도달 노인 9,551명의 감소폭'],
        ], ['c', 'l', 'l']),
      p('성과 지표 자체를 바꾸는 것도 제안의 일부다. 현재 지표(정류장 수, 운행 횟수, 평면 거리 500m 커버율)로는 성남 원도심이 계속 "양호"로 나오기 때문이다. 이를 "경사 기준 이하로 정류장에 도달하지 못하는 노인 수", "환승 대기 시간", "고도 반영 접근권 커버율"로 대체한다.'),

      h('3.13 탄소중립과의 연결', HeadingLevel.HEADING_2),
      p('이 분석은 탄소 감축량을 추정하지 않는다. 대신 접근성과 탄소중립의 관계를 다음과 같이 규정한다.'),
      quote('탄소중립 정책은 자동차를 쓰기 어렵게 만드는 방향으로 간다. 그러나 대중교통에 닿을 수 없는 사람에게 이것은 감축이 아니라 이동의 박탈이다. 이 19,268명은 탄소정책이 강해질수록 먼저 고립된다. 접근성 확보는 탄소중립의 부수 효과가 아니라 전제조건이다.'),
      p('내연기관 규제, 주차 요금 인상, 교통유발부담금은 모두 승용차 이용의 비용을 올려 대중교통으로 수단을 전환시키는 정책이다. 이 전환은 대중교통에 도달할 수 있는 사람에게만 성립한다. 성남 원도심의 19,268명에게는 전환할 대안이 없으므로, 같은 정책이 이동 자체를 줄이는 방향으로 작용한다. 탄소중립이 진전될수록 이동격차가 벌어지는 구조이며, 이 보고서가 다루는 대상은 그 구조의 가장 앞줄에 있다.'),
      p('계층별로 탄소 효과의 성격이 다르므로 구분해 기술한다.'),
      table([1600, 2200, 5560],
        ['계층', '탄소 효과', '근거와 조건'],
        [
          ['1단계 보행로·승강시설', '가장 확실', '새 차량이 발생하지 않는다. 승강시설의 전력 소비는 승용차 통행 1회의 배출과 비교해 수 자릿수 작다. 기존 노선의 이용률을 올리는 조치이므로 추가 운행 없이 효과가 난다'],
          ['2단계 노선 수직 재배치', '양호', '신규 차량 투입이 아니라 기존 마을버스의 선형 조정이다. 총 운행 거리 증가는 제한적이며, 빈 구간을 줄이는 방향이면 오히려 감소할 수 있다'],
          ['3단계 DRT', '조건부', 'DRT는 소형 차량을 낮은 재차 인원으로 운행하므로, 승객 1인당 배출이 만차 버스보다 클 수 있다. 승용차·택시 통행을 대체할 때만 감축이며, 도보나 기존 버스를 대체하면 배출이 늘어난다. 도입 시 대체 수단 조사를 전제로 해야 한다'],
        ], ['l', 'c', 'l']),
      p('감축량을 정량화하려면 대상 지역 주민의 현재 이동 수단을 알아야 한다. 승용차를 쓰고 있다면 전환은 감축이지만, 이동을 포기하고 있다면 접근성 개선은 통행을 늘려 배출을 증가시킨다. 후자라면 이는 형평성 측면의 성과이지 감축 성과가 아니며, 보고서는 이를 구분해 기술해야 한다. 현재 공개 자료는 시군 단위(성남시 비사업용 승용차 일평균 33.0km, 2019년)까지만 제공되어 구·동 단위 비교가 불가능하며, 성남통계연보 등 시 자체 자료 확인이 필요하다.'),

      h('3.14 남은 작업', HeadingLevel.HEADING_2),
      bullet('사례 지역 13곳 현장 확인 — 상대원3동 6곳(대표), 신흥2동 3곳, 은행2동·양지동 3곳. 계단인지 인도인지, 난간·쉼터가 있는지'),
      bullet('상대원3동 B·E 우선 확인 — 3단계이며 최대 경사가 -36.7%, -38.7%로 가장 급함'),
      bullet('소형 전기버스 도입 검토 — 성남시 마을버스 전기 전환 현황, 보조금 체계, 등판 성능과 최소 회전반경 확인'),
      bullet('정류장 신설 후보 4곳의 현장 확인 — 실제 도로 위에 있는지'),
      bullet('성남시 마을버스 노선도·배차 시간표 확보 후 구체적 재배치 구간 설계'),
      bullet('원도심 자동차 등록대수·주행거리 확보 — 현재 이동 수단 파악 (탄소 정량화의 전제)'),
      bullet('정류장별 승하차 자료를 성남시에 요청 — 재원 재배분의 근거'),
      bullet('마을버스 노선번호 확정 — 성남과 용인에 같은 번호가 있어 17·50·33·810·3-1 등은 미확정'),

      h('4. 한계점', HeadingLevel.HEADING_1),
      table([2600, 6760],
        ['구분', '내용'],
        [
          ['통행 구역의 근사', '수치지도 교통 레이어 주변 15m를 통행 가능 구역으로 설정했다. 실제 보도·횡단보도와 정확히 일치하지 않는다.'],
          ['계단 미구분', '계단을 일반 보행로와 구분하지 못한다. 계단 구간은 경사가 완만하게 계산될 수 있어, 19,268명은 과소 추정일 가능성이 있다.'],
          ['도보 한계 600m', '도보로 받아들일 수 있는 거리를 600m로 설정했다. 400m로 잡으면 대상이 늘고, 800m로 잡으면 줄어든다.'],
          ['기준의 성격', '8.33%(1/12)는 건축물 경사로 기준이며 보도에 그대로 적용되는 법정 기준은 아니다. "법이 통행 가능하다고 보는 최대 기울기"라는 의미로 인용해야 한다. 참고로 휠체어 경로 안내 서비스는 1/8(12.5%)을 회피 기준으로 사용한다.'],
          ['인구 통계 차이', '격자 고령인구(184,375명)와 주민등록 65세 이상(177,033명)이 약 4% 차이난다. 기준 시점과 산출 방식이 다르기 때문이다.'],
          ['운행 횟수 추정', '실제 운행 기록이 아니라 첫차·막차·배차간격으로 추정한 값이다. 배차 정보가 없는 16개 노선(예약제·출퇴근 전용)은 제외됐다.'],
          ['서울 버스 미포함', '경기도 API에는 서울 시내버스가 없어, 위례동 등 서울 노선 의존 지역의 운행 횟수가 실제보다 적게 집계된다.'],
          ['1단계 후보의 정밀도', '정류장 신설 후보는 노선의 정류장을 직선으로 이어 경로를 복원한 결과다. 실제 도로 선형과 다를 수 있어 현장 확인이 필요하다.'],
          ['이동 실태 미측정', '경기도는 시내버스 정류장별 승하차를 공개하지 않는다. 노인이 실제로 얼마나 버스를 이용하는지, 이용을 포기하는지는 확인하지 못했다.'],
          ['탄소 효과 미정량', '감축량을 추정하지 않았다. 대상 주민의 현재 이동 수단을 모르기 때문이며, 이동을 포기하고 있는 경우라면 접근성 개선은 통행과 배출을 늘린다.'],
          ['판정 기준의 민감도', '8.33% 기준에 근접한 인원이 많다. 기준을 10%로 올리면 19,268명이 11,139명, 12%로 올리면 7,036명으로 줄어든다. 대상의 42%가 8.33~10% 구간에 몰려 있다.'],
          ['등고선 간격 5m', '수치지도 1:5000의 등고선 간격은 5m다. 5m보다 작은 기복은 원자료에 없고 보간으로 생성되므로, 특정 지점의 계단이나 옹벽 같은 개별 구조물은 이 분석으로 확인할 수 없다. 확인 가능한 것은 해당 구간의 지형이 가파른지 여부까지다.'],
          ['지형 해상도의 민감도', '지형고도 격자가 10m이므로 10m보다 짧은 턱은 측정되지 않고, 한 칸짜리 고도 변화가 보간 오차인지 실제 계단인지 구분되지 않는다. 고도를 30m 창으로 평활하면 대상이 13,767명, 50m 창이면 11,613명으로 줄어든다. 따라서 "보수적으로 잡아도 1만 명 이상"이 안전한 기술이다.'],
          ['체감 난이도 미반영', '판정이 통과·불가의 이분법이다. 실제 난이도는 연속적이며, 계단 유무·난간·노면 상태·결빙·개인의 건강 상태에 따라 크게 달라진다. 이 분석은 그중 어느 것도 반영하지 못한다. 3.4절의 현장 확인에서 해당 구간이 인도로 밝혀진 것이 이 한계의 실례다.'],
          ['지형고도의 경사 과대', '현장 확인과 등고선 대조에서 지형고도가 국지 경사를 부풀리는 경향이 확인됐다. 금광2동 확인 구간은 지형고도 30~37%였으나 등고선 실측은 20~21%였다. 개별 지점의 경사값은 등고선 대조나 현장 확인을 거쳐 인용해야 한다.'],
          ['사례 지역의 대표성', '3.5절의 13곳은 버스 진입 가능 도로 근접, 아파트 단지 제외 등의 조건으로 추린 결과다. 현장 확인과 예시를 위한 선정이므로 대상 19,268명의 분포를 대표하지 않는다. 특히 아파트 단지를 제외했기 때문에 단지 거주 대상자는 이 13곳에 포함되지 않는다.'],
          ['현장 확인의 진행도', '13곳 가운데 확인된 곳은 한 곳이다. 나머지는 지형고도와 등고선 자료에 의한 추정이며, 계단·난간·노면 상태는 확인되지 않았다.'],
          ['노선번호 중복', '경기도 노선번호는 시·군 간 중복된다. 캐시한 262개 노선 중 14개 이름이 중복되어, 17·17-1·50·33·810·3-1·7 등의 노선 정보는 확정되지 않았다. 10·88·7-2·3-3·3-4 계열은 중복이 없다.'],
        ], ['l', 'l']),

      h('부록. 데이터 신뢰성 검증 기록', HeadingLevel.HEADING_1),
      p('분석 과정에서 두 차례 결과를 폐기하고 다시 계산했다. 두 경우 모두 대조군 검증에서 오류가 드러났다.'),
      p('첫째, 지형 데이터로 처음 사용한 위성 기반 SRTM(30m)은 폐기했다. 평지인 분당구가 원도심보다 더 가파르게 나왔기 때문이다. SRTM은 지면이 아니라 표면을 측정하므로 고층 아파트가 많은 분당의 건물 높이가 지형으로 잡힌 것이다. 이후 수치지도 등고선 기반으로 교체했다.'),
      p('둘째, 직선 기준으로 계산한 32,669명은 도로망 기준 19,268명으로 수정했다. 실제 도로를 따라 우회하면 기준 이하로 도달 가능한 경우가 상당수 있었기 때문이다.'),
      p('셋째, 계층별 인원을 덩어리 단위에서 격자 단위로 다시 판정했다. 덩어리마다 버스와 가장 가까운 격자를 대표로 삼은 탓에 덩어리 전체가 실제보다 버스에 가깝게 분류되어 있었다. 1단계가 8,294명에서 2,352명으로, 2단계가 1,405명에서 7,365명으로 바뀌었으며, 세 계층의 합이 19,268명으로 정확히 맞는 것을 확인했다. 종전 정리에서는 세 계층의 합이 19,850명으로 대상 총계를 초과했는데, 정류장 신설 대상이 다른 계층과 중복 집계된 것이 원인이었다.'),
      p('넷째, 지형고도에서 급경사로 산출된 지점을 원자료인 등고선과 대조했다. 대상 인원이 많은 12개 지점 중 6곳은 일치, 3곳은 실제로 가파르나 지형고도가 과장, 3곳은 과대 산출이었다. 과대로 판정된 3곳은 반경 30m 안에 등고선이 없는 평탄지로, 보간 오차로 판단된다. 1단계의 최대 지점인 금광2동은 지형고도 23%, 등고선 실측 23%로 정확히 일치했다.'),
      p('다섯째, 1단계 대상이 집중된 금광2동과 양지동을 현장 확인했다. 두 곳 모두 급경사 구간이 계단이 아니라 인도였다. 금광2동에서는 다음을 확인했다. 그 결과 두 가지를 수정했다. 하나는 해당 구간이 계단이 아니라 인도였다는 것이고, 다른 하나는 지형고도가 경사를 30~37%로 산출했으나 등고선 실측은 20~21%였다는 것이다. 이에 따라 대상을 "정류장에 도달하지 못하는 노인"이 아니라 "기준을 넘는 경사를 지나야 하는 노인"으로 다시 규정하고, 1단계 조치에서 경사형 승강시설을 빼고 난간·쉼터·제설 대책으로 교체했다. 한편 경로의 구조 자체는 확인됐다. 전체 고도차 14.6m 중 9.5m가 28m 구간에 몰려 있어, "짧은 구간 하나가 막는다"는 계산과 현장이 일치했다. 양지동은 지형이 지속형이고 주거가 빌라촌이어서 금광2동과 조건이 달랐으나, 급경사 구간이 인도라는 결과는 같았다. 다만 확인한 두 곳은 모두 1단계이며, 버스가 접근하지 못하는 3단계 지역은 확인하지 못했다.'),
      p('대상 인원이 판정 기준에 얼마나 민감한지도 함께 측정했다. 보행 기준을 8.33%에서 10%로 올리면 11,139명, 12%로 올리면 7,036명이 된다. 지형고도를 30m 창으로 평활하면 13,767명, 50m 창이면 11,613명이 된다. 평활 시 전체 도로의 가파른 구간 비율은 29.4%에서 29.5%로 거의 변하지 않으므로, 줄어드는 원인은 지형이 완만해져서가 아니라 길을 막던 한 칸짜리 턱이 지워지기 때문이다.'),
      table([3400, 5960],
        ['검증 항목', '결과'],
        [
          ['지형고도 정확도', '표고점 3,572개를 계산에서 제외하고 대조 — 오차 중앙값 1.10m, 90%가 ±3.3m 이내'],
          ['산 정상 대조', '청계산 실제 618m / 산출 617m'],
          ['평지 대조 (모란역·태평역·탄천)', '경사 0.6~2.5%로 평지로 산출됨'],
          ['평지 대조 (분당 삼평·야탑·이매동)', '기준 초과 비율 0.0% — SRTM에서 실패했던 검증을 통과'],
          ['정류장 위치', '1,405개 전부 성남 경계 내, 번호·좌표 중복 0건'],
          ['노선-정류장 연결', '1,405개 중 98.5% 연결. 미연결은 IC·요금소 등 미정차 지점'],
          ['도로망 연결성', '통행 가능 격자 773,929개 중 96%가 하나로 연결, 정류장 1,292곳 전부 연결'],
          ['행정경계 면적', '합계 141.8km² (실제 141.7km²)'],
          ['인구 합계', '899,806명 (성남시 실제 인구와 일치)'],
        ], ['l', 'l']),
    ],
  }],
});

Packer.toBuffer(doc).then((b) => {
  fs.writeFileSync(process.argv[2], b);
  console.log('written', process.argv[2], b.length, 'bytes');
});
